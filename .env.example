# Mercado Libre OAuth credentials; set values only in the ignored local .env file.
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=
MELI_REDIRECT_URI=
MELI_ACCESS_TOKEN=
MELI_REFRESH_TOKEN=
MELI_SITE_ID=MLC
MELI_USE_PKCE=false
MELI_REQUESTS_PER_SECOND=3

# Application settings.
APP_APP_NAME=Product Radar
APP_ENVIRONMENT=development
APP_PUBLIC_BASE_URL=http://localhost:3000
APP_FRONTEND_PORT=3000
APP_ALLOWED_HOSTS=["localhost","127.0.0.1"]
APP_LOG_LEVEL=INFO
APP_WORKER_POLL_SECONDS=2
APP_WORKER_HEARTBEAT_SECONDS=10
APP_SESSION_HOURS=8
APP_LOGIN_MAX_FAILURES=5
APP_LOGIN_LOCK_MINUTES=15
APP_ENRICHMENT_SELLER_LIMIT=100
APP_ENRICHMENT_KEYWORD_LIMIT=20
APP_ENRICHMENT_ITEMS_PER_PRODUCT=5
APP_ENRICHMENT_SHIPPING_ITEM_LIMIT=20
APP_ENRICHMENT_DESTINATION_ZIP_CODES=8320000,2340000,4030000,1240000
APP_UID=1000
APP_GID=1000

# Optional remote tunnel; keep its token only in the ignored local .env.
TUNNEL_TOKEN=
